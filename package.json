{
  "name": "terrain",
  "version": "0.1.0",
  "description": "A Koin-inspired, DSL-based dependency injection framework for TypeScript. No decorators, no reflection.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dependency-injection",
    "di",
    "ioc",
    "container",
    "koin",
    "typescript"
  ],
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "tsx test/run.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "quality": "bun run lint && bun run format && bun run typecheck && bun run typecheck:test && bun run test",
    "quality:fix": "bun run lint:fix && bun run format:fix && bun run typecheck && bun run typecheck:test && bun run test",
    "prepublishOnly": "bun run quality && bun run build"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "tsdown": "^0.22.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "access": "public"
  }
}